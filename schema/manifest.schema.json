{
  "type": "object",
  "required": ["schema", "launchDate", "latest", "puzzles"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "launchDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "latest": { "$ref": "#/$defs/latestEntry" },
    "puzzles": { "type": "array", "items": { "$ref": "#/$defs/manifestEntry" } }
  },
  "$defs": {
    "latestEntry": {
      "type": "object",
      "required": ["date", "number"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "number": { "type": "integer", "minimum": 1 }
      }
    },
    "manifestEntry": {
      "type": "object",
      "required": ["date", "number", "id"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "number": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "pattern": "^mtd-[0-9]{4}$" }
      }
    }
  }
}
