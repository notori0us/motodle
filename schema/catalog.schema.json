{
  "type": "object",
  "required": ["schema", "generatedAt", "source", "makes", "models"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source": { "enum": ["seed", "wikimedia-commons", "wikidata", "commons+wikidata"] },
    "makes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/make" } },
    "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/model" } }
  },
  "$defs": {
    "make": {
      "type": "object",
      "required": ["id", "name", "country", "aliases"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "aliases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "makeId", "name", "aliases", "years"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "makeId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "years": {
          "type": ["array", "null"],
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
